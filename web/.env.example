# 推奨・判定・抽出に使う（必須）
ANTHROPIC_API_KEY=
# 遺族の窓口の共有リンクの宛先（任意）。例：http://192.168.0.10:3100 や公開先の URL
NEXT_PUBLIC_FAMILY_ORIGIN=

# Google ログイン（任意）。3つそろったときだけ有効になり、担当者の画面はログインが必要になる
# Google Cloud Console で OAuth クライアント（ウェブ アプリケーション）を作り、
# 承認済みのリダイレクト URI に http://localhost:3200/api/auth/google/callback を入れる
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# セッションの署名の鍵（例：openssl rand -base64 32 の出力）
AUTH_SECRET=
# 入れる人（カンマ区切り。「@example.com」でドメイン単位）。空なら Google アカウントなら誰でも
AUTH_ALLOWED_EMAILS=
